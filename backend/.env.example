# 服务配置
HOST=0.0.0.0
PORT=8000
ENV=dev
# PostgreSQL 启动时自动 Alembic upgrade head；生产建议 false
AUTO_MIGRATE=true
# 逗号分隔；生产不要用 *
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
READY_REQUIRE_LLM=false
READY_CHECK_LLM=true

# 数据库与存储
DATABASE_URL=sqlite:///./local.db
REDIS_URL=redis://localhost:6379/0
CHROMA_DB_DIR=./storage/chroma_db
UPLOAD_DIR=./storage/uploads
IMAGE_DIR=./storage/images

# OpenAI-compatible model endpoints. Replace these values locally.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
VLM_BASE_URL=http://localhost:11434/v1
VLM_API_KEY=ollama
VLM_MODEL=llava:7b

# 任务并发控制
MAX_PARSING_WORKERS=2

# 切分参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# VLM 提示词
VLM_PROMPT=请详细描述这张图片的内容，包括图表中的数据趋势、关键文字信息。

# 鉴权配置（W1）
# 必填，无默认值；至少 32 字符。生成命令：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 未配置时后端启动会直接报错，不会使用内置密钥兜底。
JWT_SECRET=
JWT_ALG=HS256
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7

# 记忆持久化：true = PostgreSQL 为真源，Redis 仅缓存（默认）
MEMORY_PERSISTENCE=true

# 向量后端：pgvector（默认）或 chroma
VECTOR_BACKEND=pgvector
PGVECTOR_DIM=1024

# HTTP 请求日志（测试环境设为 false）
REQUEST_LOG_ENABLED=true

# Langfuse tracing（可选；public/secret key 都为空时自动 no-op）
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# metadata：只发长度/ID；redacted：正则脱敏后发送；full：仅自托管环境
TRACE_CONTENT_MODE=redacted

# ==================== 本地真实简历（不要提交） ====================
# 这些值只用于本机评测脚本；仓库里不写真实姓名/文件名。
PERSONAL_KB_NAME=
E2E_RESUME_MAIN=
E2E_RESUME_ALGO=
E2E_RESUME_BACKEND=
E2E_RESUME_JAVA=
CHUNKING_PDF_PATH=
CHUNKING_DOCX_PATH=
RESUME_NAMES=
